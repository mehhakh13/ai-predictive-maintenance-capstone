# ============================================================
# LLM Backend Selection
# ============================================================

# Use Ollama (free, local) or Claude API (paid, cloud)
USE_OLLAMA=true  # true = Ollama (default), false = Claude API

# ============================================================
# Ollama Settings (FREE - Default)
# ============================================================

# Ollama base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use
# Options: llama3.1:8b, llama3.1:70b, mistral, phi3, etc.
# OLLAMA_MODEL=llama3.1:8b

# ============================================================
# Claude API Settings (PAID - Optional)
# ============================================================

# Anthropic Claude API Key (only needed if USE_OLLAMA=false)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_api_key_here

# Optional: Override default model
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# Chat Settings
# ============================================================

# Optional: Adjust conversation history length
# MAX_CONVERSATION_HISTORY=10
